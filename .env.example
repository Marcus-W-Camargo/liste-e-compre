# Copie para .env.local e preencha. Não publique .env.local.
# Somente estas DUAS variáveis são públicas e vão para o navegador.
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_COLE_A_CHAVE_PUBLICA

# Servidor: mesma URL acima e chave SECRET do projeto novo.
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SECRET_KEY=sb_secret_COLE_A_CHAVE_SECRETA

# Gere localmente: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_VERIFICATION_SECRET=COLE_UMA_CHAVE_ALEATORIA_GERADA_LOCALMENTE

# Local: use exatamente este endereço no navegador, sem barra no final.
# Vercel Production: https://listeecompre.vercel.app
APP_ORIGIN=http://127.0.0.1:5173

# EmailJS: todos os valores devem pertencer à MESMA conta. Sem prefixo VITE_.
EMAILJS_PUBLIC_KEY=COLE_A_CHAVE_PUBLICA_EMAILJS
EMAILJS_PRIVATE_KEY=COLE_UMA_NOVA_CHAVE_PRIVADA_EMAILJS
EMAILJS_SERVICE_ID=service_COLE_O_ID
EMAILJS_TEMPLATE_CADASTRO_ID=template_COLE_O_ID
EMAILJS_TEMPLATE_RECUPERACAO_ID=template_COLE_O_ID
